#!/bin/bash
# Removes this extra control plane node from the cluster before Terraform
# destroys its server, so that lowering master_count doesn't leave etcd
# with members that no longer exist (and so without quorum).
#
# It drains the node, removes its etcd member, stops its control plane and
# deletes its Node. It doesn't run kubeadm reset: the server is about to be
# destroyed.

set -eu

# Retries a command on failure.
# $1 - the max number of attempts
# $2... - the command to run
retry() {
    local max_attempts="${1}"; shift
    local attempt_num=1

    until "${@}"
    do
        if [ "${attempt_num}" -eq "${max_attempts}" ]
        then
            echo "Attempt ${attempt_num} failed and there are no more attempts left!"
            return 1
        else
            echo "Attempt ${attempt_num} failed! Trying again in ${attempt_num} seconds..."
            sleep $(( attempt_num=attempt_num + 1 ))
        fi
    done
}

node=$(hostname)

admin_kubectl() {
    sudo kubectl --kubeconfig /etc/kubernetes/admin.conf "$@"
}

# Runs etcdctl in the etcd pod on node $1
etcdctl_on() {
    local pod_node="$1"; shift
    admin_kubectl -n kube-system exec "etcd-${pod_node}" -- etcdctl \
        --cacert /etc/kubernetes/pki/etcd/ca.crt \
        --cert /etc/kubernetes/pki/etcd/healthcheck-client.crt \
        --key /etc/kubernetes/pki/etcd/healthcheck-client.key \
        "$@"
}

echo "Removing ${node} from the control plane"

if [ ! -f /etc/kubernetes/admin.conf ]
then
    if [ -n "$(ls -A /etc/kubernetes/manifests 2>/dev/null)" ]
    then
        echo "ERROR: ${node} has control plane manifests but no admin.conf, so a"
        echo "join may have got part way. Check whether it is in the etcd member"
        echo "list, remove it with 'etcdctl member remove' if so, then apply again."
        exit 1
    fi
    echo "${node} never joined the control plane - nothing to remove"
    exit 0
fi

# Use another control plane node's etcd pod, which keeps working after this
# node's etcd is removed
other=$(admin_kubectl get nodes -l node-role.kubernetes.io/control-plane \
    -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' | grep -vx "${node}" | head -1 || true)
if [ -z "${other}" ]
then
    echo "ERROR: no other control plane node found - refusing to remove ${node}"
    exit 1
fi

echo "Checking etcd using the etcd pod on ${other}"
members=$(etcdctl_on "${other}" member list)
echo "${members}"
# Fields: ID, status, name, peer URLs, client URLs, is learner
member_id=$(echo "${members}" | awk -F', ' -v name="${node}" '$3 == name {print $1}')

# Removing a member while another is unhealthy can leave etcd without quorum
if ! etcdctl_on "${other}" endpoint health --cluster
then
    echo "ERROR: not every etcd member is healthy, so ${node} has not been removed."
    echo "Fix etcd, or remove ${node} by hand, then apply again."
    exit 1
fi

echo "Draining ${node}"
if ! admin_kubectl drain "${node}" --ignore-daemonsets --delete-emptydir-data --timeout=5m
then
    echo "ERROR: draining ${node} failed, so it has not been removed."
    echo "Run 'kubectl uncordon ${node}' to put it back into service."
    exit 1
fi

if [ -n "${member_id}" ]
then
    echo "Removing etcd member ${member_id} (${node})"
    etcdctl_on "${other}" member remove "${member_id}"
else
    echo "${node} is not an etcd member"
fi

echo "Stopping the control plane on ${node}"
sudo mkdir -p /etc/kubernetes/manifests-removed
sudo find /etc/kubernetes/manifests -maxdepth 1 -name '*.yaml' \
    -exec mv -t /etc/kubernetes/manifests-removed {} +
# Wait for the API server to stop, so the load balancer stops using it
for _ in $(seq 60)
do
    ss -lnt | grep -q ':6443 ' || break
    sleep 1
done
# Stop kubelet so it doesn't register the Node again
sudo systemctl disable --now kubelet

echo "Deleting node ${node}"
retry 10 admin_kubectl delete node "${node}" --ignore-not-found

echo "${node} removed from the cluster"

#!/bin/bash

set -eu
APT_GET="sudo DEBIAN_FRONTEND=noninteractive NEEDRESTART_SUSPEND=1 apt-get -o Dpkg::Options::=--force-confold -o Dpkg::Options::=--force-confdef -qq -y"

echo "Waiting for base package installation to complete"
# Exit status 2 means cloud-init finished with recoverable errors
cloud-init status --wait >/dev/null || [ $? -eq 2 ]

echo "Adding repositories"

rel=${kubernetes_release}
sudo mkdir -p /etc/apt/keyrings
%{ if tonumber(split(".", kubernetes_release)[1]) < 24 ~}
sudo rm -f /etc/apt/sources.list.d/*http_orbit_brightbox_com_v1_acc-tqs4c_apt_kubernetes_io*.list /etc/apt/sources.list.d/kubernetes.sources
curl -fsSL https://raw.githubusercontent.com/kubernetes/k8s.io/main/apt/doc/apt-key.gpg | sudo gpg --batch --yes --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg
echo "deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] http://orbit.brightbox.com/v1/acc-tqs4c/apt.kubernetes.io/ kubernetes-xenial main" | sudo tee /etc/apt/sources.list.d/kubernetes.list
%{ else ~}
curl -fsSL https://pkgs.k8s.io/core:/stable:/v$${rel%.*}/deb/Release.key | sudo gpg --batch --yes --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg
echo "deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/v$${rel%.*}/deb/ /" | sudo tee /etc/apt/sources.list.d/kubernetes.list
%{ endif ~}
sudo rm -f /etc/apt/sources.list.d/kubernetes-old.list /etc/apt/sources.list.d/docker.list /usr/share/keyrings/kubernetes.gpg

echo "Installing versioned packages"

$${APT_GET} update
kube_rel=""
kube_rel=$(apt-cache madison "kubeadm" | grep -Po -m 1 "(?<= )${kubernetes_release}[^ ]*")
if [ -z "$${kube_rel}" ]
then
    kube_rel="${kubernetes_release}"
fi
cri_rel=""
cri_rel=$(apt-cache madison "cri-tools" | grep -Po -m 1 "(?<= )${critools_release}[^ ]*")
if [ -z "$${cri_rel}" ]
then
    cri_rel="${critools_release}"
fi
$${APT_GET} --allow-change-held-packages install \
    containerd \
	kubeadm=$${kube_rel} \
	kubectl=$${kube_rel} \
	kubelet=$${kube_rel} \
	cri-tools=$${cri_rel}
sudo apt-mark hold kubeadm kubectl kubelet cri-tools
